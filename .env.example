# Optional: only needed for AI-generated coding suggestions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: only needed to transcribe audio recordings.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Optional: use a recordings directory outside this repository.
RECORDINGS_FOLDER=

# Optional: set this only if Python cannot find your system CA certificates.
CA_BUNDLE_PATH=
